{
  "name": "@meridian/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=../.env watch src/server.ts",
    "start": "node --env-file-if-exists=../.env dist/server.js",
    "lint": "eslint . --config ../eslint.config.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test:unit": "vitest run --config vitest.config.ts --exclude tests/integration/**",
    "test:integration": "node --env-file-if-exists=../.env ../node_modules/vitest/vitest.mjs run --config vitest.config.ts tests/integration",
    "prisma:generate": "node --env-file-if-exists=../.env ../node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node --env-file-if-exists=../.env ../node_modules/prisma/build/index.js migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "express": "^5.0.0",
    "helmet": "^8.3.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "prisma": "^6.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
