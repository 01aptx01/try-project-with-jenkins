{
  "name": "@meridian/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=../.env watch src/server.ts",
    "start": "node --env-file-if-exists=../.env dist/server.js",
    "lint": "eslint . --config ../eslint.config.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node -e \"try { fs.rmSync('dist', { recursive: true, force: true }); } catch {}\" && tsc -p tsconfig.build.json",
    "test:unit": "vitest run --configLoader runner --config vitest.config.ts --exclude tests/integration/**",
    "test:integration": "node --env-file-if-exists=../.env ../node_modules/vitest/vitest.mjs run --configLoader runner --config vitest.config.ts tests/integration",
    "prisma:generate": "node --env-file-if-exists=../.env ../node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node --env-file-if-exists=../.env ../node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "tsx --env-file-if-exists=../.env src/seed/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.0.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "prisma": "^6.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
